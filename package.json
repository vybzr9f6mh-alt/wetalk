{
  "name": "wetalk",
  "version": "1.0.0",
  "description": "WeTalk - a WeChat-like instant messenger (Node + WebSocket + SQLite)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tools/test-e2e.mjs",
    "icons": "python3 tools/gen_icons.py public",
    "set-server": "node tools/set-server.mjs",
    "cap:android": "cap add android && cap sync android",
    "cap:ios": "cap add ios && cap sync ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
